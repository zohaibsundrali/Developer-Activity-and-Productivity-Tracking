# ---------------------------------------------------------------------------
# Environment template. Copy to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# NEVER commit `.env.local`. NEVER paste a real value into this file.
# Full documentation, including rotation procedures: docs/secrets-and-environment.md
#
# NEXT_PUBLIC_* variables are inlined into the JavaScript bundle at build time
# and are therefore PUBLIC. Anything not prefixed NEXT_PUBLIC_ is server-only
# and must never be imported from a "use client" component.
# ---------------------------------------------------------------------------


# === Supabase (required) ===================================================

# REQUIRED (public). Your Supabase project URL. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED (public by design). Supabase anonymous key. This is a JWT that ships
# in the client bundle on purpose; it is only safe because Row Level Security
# constrains it. Do not use it as a substitute for the service-role key.
# (real value is a three-part JWT: <header>.<payload>.<signature>)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# REQUIRED (SECRET, server-only). Supabase service-role key. Bypasses RLS
# entirely — treat it as a root database password. Every /api route uses it.
# Missing => API routes return HTTP 500 "Server misconfigured", or silently fall
# back to the anon key in older routes (which then fail on RLS).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key


# === Session signing (required in production) ==============================

# STRONGLY RECOMMENDED (SECRET, server-only). HMAC key for the `dt_session`
# auth cookie that middleware verifies on every protected navigation.
# Generate with:  openssl rand -base64 48
# Missing => src/utils/sessionCookie.js falls back to SUPABASE_SERVICE_ROLE_KEY
# as signing material, which couples the two secrets: a service-role key leak
# then also grants the ability to FORGE ADMIN SESSIONS. Set this explicitly.
SESSION_COOKIE_SECRET=replace-with-64-random-bytes-base64


# === Desktop agent ingest (required in production) =========================

# REQUIRED IN PRODUCTION (SECRET, server-only). Shared secret the desktop
# tracker sends as `x-ingest-secret` to /api/track-activity and
# /api/upload-screenshot.
# Missing => BOTH endpoints FAIL OPEN and accept unauthenticated writes.
# Generate with:  openssl rand -hex 32
DESKTOP_INGEST_SECRET=replace-with-random-hex-32


# === Scheduled jobs ========================================================

# REQUIRED to run cron (SECRET, server-only). Bearer token guarding /api/cron
# (due-date reminders, recurring task spawning).
# Missing => the route fails CLOSED; scheduled jobs simply never run.
# Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-random-hex-32


# === Stripe billing (optional — billing disabled when unset) ===============

# OPTIONAL (SECRET, server-only). Stripe secret key. `sk_test_` for staging,
# `sk_live_` for production; the billing UI badges which mode is active.
# Missing => billingConfigured() is false and billing endpoints refuse cleanly.
STRIPE_SECRET_KEY=sk_test_replace_me

# OPTIONAL (SECRET, server-only). Stripe webhook signing secret, used to verify
# webhook payload signatures. Missing => webhook verification is unavailable.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# OPTIONAL. Days of access retained after a failed payment. Default: 3.
BILLING_GRACE_PERIOD_DAYS=3


# === Email delivery (optional — email silently disabled when unset) ========

# OPTIONAL (server-only). Gmail account used as the SMTP sender for invitations
# and verification email.
GMAIL_EMAIL=your-sender@example.com

# OPTIONAL (SECRET, server-only). Gmail App Password (NOT the account password).
# Missing => mailer.js reports "not configured" and email is skipped silently.
GMAIL_APP_PASSWORD=replace-with-16-char-app-password

# OPTIONAL (all public). EmailJS browser-side send. These three are public by
# design; EmailJS expects them in client code and rate-limits per domain.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=replace-with-emailjs-public-key


# === AI task generation (optional) =========================================

# OPTIONAL (SECRET, server-only). HuggingFace inference API token used by
# /api/ai-generate-tasks. Missing => AI task generation is unavailable.
HUGGINGFACE_API_KEY=hf_replace_me


# === URLs (optional but recommended in production) =========================

# RECOMMENDED (public). Absolute origin used for Stripe Checkout return URLs.
# Missing => falls back to the request origin, which a spoofed Host header could
# influence. Set it explicitly in production.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# OPTIONAL (public). Absolute origin used when building client notification
# links. Falls back to NEXT_PUBLIC_APP_URL, then to a relative URL.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# OPTIONAL (public). Endpoint the browser logger POSTs client errors to.
# Missing => client-side error reporting is disabled.
NEXT_PUBLIC_ERROR_REPORT_URL=


# === Local QA scripts only (never set in production) =======================
# Used by scripts/saas-qa.cjs, scripts/login-test.cjs, scripts/qa_isolation_probe.mjs.

# OPTIONAL. Base URL the QA scripts probe. Default: http://localhost:3200
BASE=http://localhost:3200

# OPTIONAL (SECRET). Throwaway QA-only accounts. Never real user credentials.
ADMIN_EMAIL=qa-admin@example.com
ADMIN_PASSWORD=replace-with-throwaway-password
CLIENT_EMAIL=qa-client@example.com
CLIENT_PASSWORD=replace-with-throwaway-password
